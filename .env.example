# ==============================================================================
# SHOPSPHERE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development or configure these variables
# in the Render Dashboard (Environment tab) for production deployment.
#
# DO NOT COMMIT REAL SECRETS OR YOUR '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & PORT
# ------------------------------------------------------------------------------
# Render automatically injects the PORT environment variable.
# For local development, this falls back to 5454.
# PORT=5454
# SERVER_PORT=5454

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# DatabaseConfig.java automatically converts cloud URIs ('postgres://' or 'postgresql://')
# to HikariCP JDBC format, decodes passwords with special characters, and enables SSL.
#
# For SUPABASE (Recommended - Permanent Free Tier):
# In Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Select "Use connection pooling" (Session mode, port 5432 for full IPv4 support):
# DATABASE_URL=postgresql://postgres.yourprojectref:your_password@aws-0-region.pooler.supabase.com:5432/postgres
#
# For Local Development / Self-hosted JDBC:
# DB_URL=jdbc:postgresql://localhost:5432/ecommerce_multivendor
# DB_USERNAME=postgres
# DB_PASSWORD=your_local_db_password
#
# HikariCP Connection Pool (Optional - Starter defaults: max=10, min=2)
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_POOL_CONN_TIMEOUT=30000
# DB_POOL_IDLE_TIMEOUT=300000
# DB_POOL_MAX_LIFETIME=1800000
# DB_POOL_LEAK_DETECTION=60000

# ------------------------------------------------------------------------------
# 3. JPA / HIBERNATE SETTINGS
# ------------------------------------------------------------------------------
# Production safe: 'update' automatically synchronizes schema.
# Use 'validate' only if using Flyway/Liquibase schema migrations.
# NEVER use 'create' or 'create-drop' in production!
# DDL_AUTO=update
# SHOW_SQL=false

# ------------------------------------------------------------------------------
# 4. SECURITY & JWT (CRITICAL - REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Cryptographically secure random key for signing JWT tokens.
# MUST be at least 256 bits / 64 hex characters for HMAC-SHA algorithms.
# Generate via: openssl rand -base64 64
JWT_SECRET_KEY=your-minimum-64-character-production-jwt-secret-key-replace-me!
# JWT_SECRET is also supported as an alias:
# JWT_SECRET=your-minimum-64-character-production-jwt-secret-key-replace-me!

# Access token lifetime in milliseconds (Default: 900000 ms = 15 minutes)
# JWT_ACCESS_EXPIRATION_MS=900000

# Refresh token lifetime in days (Default: 7 days)
# JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie settings: Set to 'true' and 'None' if frontend & backend are on different HTTPS domains
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None

# ------------------------------------------------------------------------------
# 5. CORS & FRONTEND URLS
# ------------------------------------------------------------------------------
# URL of the hosted frontend (Render, Vercel, Netlify, custom domain).
# Supports comma-separated list of origins.
FRONTEND_URL=https://your-shopsphere-frontend.onrender.com
# APP_CORS_ALLOWED_ORIGINS=https://your-shopsphere-frontend.onrender.com,http://localhost:5173
# PAYMENT_CALLBACK_BASE_URL=https://your-shopsphere-frontend.onrender.com

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Get your API keys from the Razorpay Dashboard (Settings -> API Keys).
# Use 'rzp_test_...' for test/sandbox mode, 'rzp_live_...' for production.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (SMTP / Gmail)
# ------------------------------------------------------------------------------
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
MAIL_USERNAME=your-store-email@gmail.com
MAIL_PASSWORD=your-16-character-smtp-app-password

# ------------------------------------------------------------------------------
# 8. INITIAL ADMIN SEEDING (Optional)
# ------------------------------------------------------------------------------
# If provided, an admin account will be seeded automatically on first startup.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong-admin-initial-password-replace-me
ADMIN_FULL_NAME=ShopSphere Admin
# OTP_EXPIRY_MINUTES=10

# ------------------------------------------------------------------------------
# 9. AI SHOPPING ASSISTANT (Groq & Gemini APIs)
# ------------------------------------------------------------------------------
# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_TOKENS=1024
# GROQ_TEMPERATURE=0.5

# Google Gemini API Key (Alternative LLM Provider)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# AI Rate Limiting (Requests per minute per user/IP)
# AI_RATE_LIMIT=60

# ------------------------------------------------------------------------------
# 10. LOGGING
# ------------------------------------------------------------------------------
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_SECURITY=WARN
